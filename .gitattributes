* text=auto eol=lf

# 文本文件统一使用 LF，避免 Windows 提交带入 CRLF
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
_headers    text eol=lf
_redirects  text eol=lf

# 二进制文件不做文本转换与行级 diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.apk       binary
*.woff      binary
*.woff2     binary
*.ttf       binary